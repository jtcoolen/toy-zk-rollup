        bytes32 root = bytes32(0x088cc9a205cbb7aaf226bbbc2c53ca7a5fedff2e4478bed324bd563cd42fdc40);
        bytes32[DEPTH] memory bad = s0_at_zero();
        bad[7] = bytes32(uint256(0xdead));
        assertFalse(
            MerkleProof.verify(root, 0, bytes32(0x0101010101010101010101010101010101010101010101010101010101010101), bad),
            "a tampered sibling must not verify"
        );
    }

