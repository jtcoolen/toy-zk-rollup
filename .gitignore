# Rust
/target/
**/*.rs.bk

# Local toolchain homes (large, machine-specific)
.cargo-home/
.home/

# Node / wallet
node_modules/
wallet/dist/

# Editor
.DS_Store
*.swp

# Scratch reference clones. The vendored *source of truth* for the Solidity
# verifier lives in contracts/lib/sol-whir-p3 (committed, byte-identical to
# upstream). `.scratch/vendor/` is only the working clone used to diff against
# upstream, so it is ignored rather than committed.
/tmp/
.scratch/vendor/

contracts/out/
contracts/cache/
contracts/broadcast/
contracts/deployments/

# Reference clones for study only (sol-whir-p3, plutus-plonky3-exploration,
# bitcoin-stark-verifier). The committed source of truth for the Solidity
# verifier is contracts/lib/sol-whir-p3; these are throwaway study copies.
.scratch/refs/
