{
  "manifest_version": 3,
  "name": "PQ Shielded Wallet",
  "version": "0.1.0",
  "description": "Post-quantum shielded-pool wallet for the WHIR rollup demo (SPHINCS+ spend auth, vault sealed with Argon2id + AES-256-GCM).",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PQ Shielded Wallet"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; connect-src http://127.0.0.1:* http://localhost:*"
  }
}
